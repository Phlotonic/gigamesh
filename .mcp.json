{
  "mcpServers": {
    "aws-mcp": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/aws/mcp-proxy-for-aws@a5dd25e0ad99d0d874f2b779435b12b10932eae7",
        "mcp-proxy-for-aws",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--skip-auth",
        "--metadata",
        "INSTALL_SOURCE=gigamesh-aws-toolkit"
      ]
    },
    "aws-devops-agent": {
      "type": "http",
      "url": "https://connect.aidevops.us-east-1.api.aws/mcp",
      "headers": {
        "Authorization": "Bearer ${DEVOPS_AGENT_TOKEN}"
      },
      "timeout": 120000
    }
  }
}
